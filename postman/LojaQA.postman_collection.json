    {
      "name": "04. Pedidos (Cliente)",
      "item": [
        {
          "name": "Criar Pedido de Compra (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.order && data.order._id) {",
                  "    pm.environment.set(\"createdOrderId\", data.order._id);",
                  "    console.log(\"ID do Pedido salvo: \" + data.order._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{firstProductId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": \"Av. Paulista, 1000 - Bela Vista, São Paulo/SP (CEP: 01310-100)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Requer autenticação. Decrementa o estoque e cria o pedido."
          },
          "response": []
        },
        {
          "name": "Listar Meus Pedidos",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/me",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "me"]
            },
            "description": "Retorna o histórico de pedidos da conta autenticada."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05. Gestão do Lojista (Seller)",
      "item": [
        {
          "name": "Listar Produtos da Minha Loja",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var list = pm.response.json();",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "    pm.environment.set(\"firstProductId\", list[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seller/products",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products"]
            },
            "description": "Lista produtos vinculados exclusivamente à loja do lojista logado."
          },
          "response": []
        },
        {
          "name": "Cadastrar Novo Produto na Loja",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.product && data.product._id) {",
                  "    pm.environment.set(\"createdProductId\", data.product._id);",
                  "    console.log(\"Produto criado salvo: \" + data.product._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mouse Gamer Óptico Pro QA {{$timestamp}}\",\n  \"description\": \"Sensor de 16000 DPI com iluminação customizável\",\n  \"category\": \"Periféricos\",\n  \"price\": 189.90,\n  \"stock\": 20,\n  \"image\": \"https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?w=600\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/seller/products",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products"]
            },
            "description": "Cadastra produto na loja. Salva o ID em `createdProductId`."
          },
          "response": []
        },
        {
          "name": "Atualizar Produto (Editar Dados)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mouse Gamer Óptico Pro QA - Atualizado\",\n  \"price\": 199.90,\n  \"stock\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/seller/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products", "{{createdProductId}}"]
            },
            "description": "Atualiza campos do produto recém criado."
          },
          "response": []
        },
        {
          "name": "Soft Delete: Desativar Produto (active: false)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/seller/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products", "{{createdProductId}}"]
            },
            "description": "💡 BOA PRÁTICA DE PRODUÇÃO: Oculta o produto da vitrine sem apagar o histórico de vendas."
          },
          "response": []
        },
        {
          "name": "Hard Delete: Excluir Produto (Teardown Pedagógico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seller/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products", "{{createdProductId}}"]
            },
            "description": "Exclui fisicamente o produto criado nos testes (Teardown). Se tentar apagar produtos do seed ou com pedidos, a API rejeitará!"
          },
          "response": []
        },
        {
          "name": "[Trava Seed] Tentar Excluir Produto Oficial do Catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Bloqueio anti-caos ativado: 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include(\"produtos padrão do catálogo oficial não podem ser excluídos\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seller/products/{{firstProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "products", "{{firstProductId}}"]
            },
            "description": "Valida a trava que impede alunos de apagarem os produtos base oficiais do sistema."
          },
          "response": []
        },
        {
          "name": "Listar Pedidos Recebidos pela Loja",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seller/orders",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "orders"]
            },
            "description": "Retorna todos os pedidos que contêm produtos desta loja."
          },
          "response": []
        },
        {
          "name": "Atualizar Status do Pedido (enviado / entregue)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenLojista}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/seller/orders/{{createdOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["seller", "orders", "{{createdOrderId}}", "status"]
            },
            "description": "Atualiza o status para pending, paid, shipped, delivered ou cancelled."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06. Administração (Admin)",
      "item": [
        {
          "name": "Listar Todos os Usuários",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var list = pm.response.json();",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "    // Procura um usuário criado não protegido",
                  "    var temp = list.find(function(u) {",
                  "        return u.email.indexOf('aluno_') !== -1 || u.email.indexOf('teste') !== -1;",
                  "    });",
                  "    if (temp) {",
                  "        pm.environment.set(\"tempUserId\", temp._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Exclusivo admin. Lista todas as contas da base de dados."
          },
          "response": []
        },
        {
          "name": "Bloquear Usuário (role: blocked)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
