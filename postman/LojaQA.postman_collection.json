                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"tokenCliente\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Token de Cliente salvo com sucesso!\");",
                  "}"
                ],
